@page
@model AutoComWeb.Pages.Admin.MechanicsModel
@{
    ViewData["Title"] = "Персонал";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people text-success"></i> Персонал (Механики)</h2>
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary btn-sm">В панель</a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="SearchTerm" asp-for="SearchTerm" class="form-control" placeholder="Поиск по фамилии или специализации..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search"></i> Найти</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Message != null)
    {
        <div class="alert alert-@Model.MessageType alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0" id="formTitle">@(Model.EditingId > 0 ? "Редактирование" : "Новый сотрудник")</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="Save" id="mechanicForm" novalidate>
                        <input type="hidden" asp-for="EditingId" id="editingId" />
                        
                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-bold">Фамилия</label>
                            <input asp-for="LastName" id="inputLastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-bold">Имя</label>
                            <input asp-for="FirstName" id="inputFirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Patronymic" class="form-label fw-bold">Отчество (необязательно)</label>
                            <input asp-for="Patronymic" id="inputPatronymic" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold">Телефон</label>
                            <input asp-for="Phone" id="Phone" class="form-control" placeholder="+7 (___) ___-__-__" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Specialization" class="form-label fw-bold">Специализация</label>
                            <input asp-for="Specialization" id="inputSpec" class="form-control" list="specList" placeholder="Например: Автоэлектрик" />
                            <datalist id="specList">
                                <option value="Автомеханик-универсал"></option>
                                <option value="Моторист"></option>
                                <option value="Автоэлектрик"></option>
                                <option value="Слесарь по ходовой"></option>
                                <option value="Диагност"></option>
                            </datalist>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-2">
                            <button type="submit" id="submitBtn" class="btn btn-success">Добавить сотрудника</button>
                            <button type="button" id="cancelBtn" class="btn btn-light" style="display:none;" onclick="resetForm()">Отмена</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ФИО сотрудника</th>
                                <th>Специализация</th>
                                <th>Телефон</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MechanicsList.Any())
                            {
                                @foreach (var m in Model.MechanicsList)
                                {
                                    <tr>
                                        <td>
                                            <strong>@m.LastName @m.FirstName</strong>
                                            @if (!string.IsNullOrEmpty(m.Patronymic)) { <span class="text-muted small d-block">@m.Patronymic</span> }
                                        </td>
                                        <td><span class="badge bg-secondary">@m.Specialization</span></td>
                                        
                                        @{
                                            string formattedPhone = m.Phone.Length == 12 ? 
                                                $"{m.Phone.Substring(0, 2)} ({m.Phone.Substring(2, 3)}) {m.Phone.Substring(5, 3)}-{m.Phone.Substring(8, 2)}-{m.Phone.Substring(10, 2)}" : 
                                                m.Phone;
                                        }
                                        <td>@formattedPhone</td>
                                        
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-success" 
                                                    onclick="editMechanic(@m.MechanicId, '@m.LastName', '@m.FirstName', '@(m.Patronymic ?? "")', '@m.Phone', '@m.Specialization')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@m.MechanicId" asp-route-SearchTerm="@Model.SearchTerm" class="d-inline"
                                                  onsubmit="return confirm('Уволить/удалить сотрудника?')">
                                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-4">
                                        <i class="bi bi-people fs-2 d-block mb-2"></i>
                                        Сотрудники не найдены
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Отключаем валидацию при вводе
        $(function () {
            var form = $('form')[0];
            if (form) {
                var validator = $.data(form, 'validator');
                if (validator) {
                    validator.settings.onfocusout = false;
                    validator.settings.onkeyup = false;
                    validator.settings.onclick = false;
                }
            }
        });

        function editMechanic(id, lastName, firstName, patronymic, phone, spec) {
            document.getElementById('editingId').value = id;
            document.getElementById('inputLastName').value = lastName;
            document.getElementById('inputFirstName').value = firstName;
            document.getElementById('inputPatronymic').value = patronymic;
            
            // Находим поле телефона и аккуратно вставляем туда значение,
            // чтобы плагин IMask его подхватил
            var phoneInput = document.getElementById('Phone');
            phoneInput.value = phone;
            // Искусственно вызываем событие input, чтобы маска обновилась
            phoneInput.dispatchEvent(new Event('input'));
            
            document.getElementById('inputSpec').value = spec;
            
            document.getElementById('formTitle').innerText = 'Редактирование';
            document.getElementById('submitBtn').innerText = 'Сохранить изменения';
            document.getElementById('cancelBtn').style.display = 'block';
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('mechanicForm').reset();
            document.getElementById('editingId').value = '';
            
            // Сбрасываем маску
            var phoneInput = document.getElementById('Phone');
            phoneInput.value = '';
            phoneInput.dispatchEvent(new Event('input'));

            document.getElementById('formTitle').innerText = 'Новый сотрудник';
            document.getElementById('submitBtn').innerText = 'Добавить сотрудника';
            document.getElementById('cancelBtn').style.display = 'none';
        }
    </script>
}