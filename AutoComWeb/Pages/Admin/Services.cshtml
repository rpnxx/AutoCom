@page
@model AutoComWeb.Pages.Admin.ServicesModel
@{
    ViewData["Title"] = "Управление услугами";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear-wide-connected text-primary"></i> Справочник услуг</h2>
        <a asp-page="/Admin/Index" class="btn btn-outline-secondary btn-sm">В панель</a>
    </div>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-10">
                    <input type="text" name="SearchTerm" asp-for="SearchTerm" class="form-control" placeholder="Поиск по названию..." />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100"><i class="bi bi-search"></i> Найти</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Message != null)
    {
        <div class="alert alert-@Model.MessageType alert-dismissible fade show">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0" id="formTitle">@(Model.EditingId > 0 ? "Редактирование" : "Новая услуга")</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-page-handler="Save" id="serviceForm">
                        <input type="hidden" asp-for="EditingId" id="editingId" />
                        
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Название</label>
                            <input asp-for="Name" id="inputName" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">Цена (₽)</label>
                                <input asp-for="Price" id="inputPrice" class="form-control" type="number" step="1" data-val-number="Введите корректное число" />
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="StandartHours" class="form-label fw-bold">Н/Ч</label>
                                <input asp-for="StandartHours" id="inputHours" class="form-control" type="number" step="0.1" data-val-number="Введите корректное число" />
                                <span asp-validation-for="StandartHours" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-2">
                            <button type="submit" id="submitBtn" class="btn btn-primary">Добавить в прайс</button>
                            <button type="button" id="cancelBtn" class="btn btn-light" style="display:none;" onclick="resetForm()">Отмена</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Название</th>
                                <th>Н/Ч</th>
                                <th>Цена</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ServicesList.Any())
                            {
                                @foreach (var s in Model.ServicesList)
                                {
                                    <tr>
                                        <td><strong>@s.Name</strong></td>
                                        <td>@s.StandartHours.ToString("N1")</td>
                                        <td>@s.Price.ToString("C0", new System.Globalization.CultureInfo("ru-RU"))</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" 
                                                    onclick="editService(@s.ServicesId, '@s.Name', @s.Price.ToString(System.Globalization.CultureInfo.InvariantCulture), @s.StandartHours.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.ServicesId" asp-route-SearchTerm="@Model.SearchTerm" class="d-inline"
                                                  onsubmit="return confirm('Удалить услугу?')">
                                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-4">
                                        <i class="bi bi-search fs-2 d-block mb-2"></i>
                                        Услуги не найдены
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Отключаем назойливую валидацию при вводе
        $(function () {
            var form = $('form')[0];
            if (form) {
                var validator = $.data(form, 'validator');
                if (validator) {
                    validator.settings.onfocusout = false;
                    validator.settings.onkeyup = false;
                    validator.settings.onclick = false;
                }
            }
        });

        function editService(id, name, price, hours) {
            document.getElementById('editingId').value = id;
            document.getElementById('inputName').value = name;
            document.getElementById('inputPrice').value = price;
            document.getElementById('inputHours').value = hours;
            
            document.getElementById('formTitle').innerText = 'Редактирование';
            document.getElementById('submitBtn').innerText = 'Сохранить изменения';
            document.getElementById('submitBtn').className = 'btn btn-success';
            document.getElementById('cancelBtn').style.display = 'block';
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetForm() {
            document.getElementById('serviceForm').reset();
            document.getElementById('editingId').value = '';
            document.getElementById('formTitle').innerText = 'Новая услуга';
            document.getElementById('submitBtn').innerText = 'Добавить в прайс';
            document.getElementById('submitBtn').className = 'btn btn-primary';
            document.getElementById('cancelBtn').style.display = 'none';
        }
    </script>
}