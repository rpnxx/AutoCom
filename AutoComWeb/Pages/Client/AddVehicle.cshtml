@page
@model AutoComWeb.Pages.Client.AddVehicleModel
@{
    ViewData["Title"] = "Добавление автомобиля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Новый автомобиль</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Brand" class="form-label">Марка</label>
                                <input asp-for="Brand" class="form-control" placeholder="Например: Toyota" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Model" class="form-label">Модель</label>
                                <input asp-for="Model" class="form-control" placeholder="Например: Camry" required />
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="Year" class="form-label">Год выпуска</label>
                                <input asp-for="Year" type="number" min="1950" max="2026" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NumberPlate" class="form-label">Госномер</label>
                                <input asp-for="NumberPlate" class="form-control" placeholder="А123АА 77" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="/Client/Index" class="btn btn-outline-secondary">Отмена</a>
                            <button type="submit" class="btn btn-success">Добавить в гараж</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>